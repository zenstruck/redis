{
    "name": "zenstruck/redis",
    "description": "Lazy proxy for php-redis with DX helpers, utilities and a unified API.",
    "homepage": "https://github.com/zenstruck/redis",
    "type": "library",
    "license": "MIT",
    "keywords": ["redis"],
    "authors": [
        {
            "name": "Kevin Bond",
            "email": "kevinbond@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-redis": "*",
        "symfony/cache": "^5.4|^6.0|^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.4",
        "phpunit/phpunit": "^9.6.21",
        "symfony/phpunit-bridge": "^6.0|^7.0",
        "symfony/var-dumper": "^5.4|^6.0|^7.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": { "Zenstruck\\": ["src/"] }
    },
    "autoload-dev": {
        "psr-4": { "Zenstruck\\Redis\\Tests\\": ["tests/"] }
    }
}
